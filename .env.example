# ============================================================================
# DeltaCare Hospital Platform — Environment Configuration (.env.example)
# Dedicated installation per hospital. Never commit real credentials.
# ============================================================================

# Application Identity & URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_HOSPITAL_NAME="DeltaCare"
NEXT_PUBLIC_HOSPITAL_TAGLINE="Care at DeltaCare"
NODE_ENV="development"

# Database (PostgreSQL — Prisma ORM)
DATABASE_URL="postgresql://deltacare_user:CHANGE_ME@localhost:5432/deltacare_hospital?schema=public"

# Authentication & Session Security (Single Unified Auth Provider)
AUTH_SECRET="replace-with-at-least-32-bytes-of-cryptographic-randomness"
AUTH_URL="http://localhost:3000"
SESSION_COOKIE_NAME="deltacare_session"

# S3-Compatible Object Storage (Doctor Profiles, Branch Media, Approved Documents)
S3_ENDPOINT="https://s3.ap-southeast-1.amazonaws.com"
S3_REGION="ap-southeast-1"
S3_BUCKET="deltacare-hospital-media"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# AI Provider Adapter (Grounded DeltaCare Assistant & Staff Update Assistant)
AI_PROVIDER="grounded-local" # Options: grounded-local | openai | gemini
AI_API_KEY=""
AI_MODEL="gemini-2.5-flash"

# Patient Communication Adapters (Email, SMS, WhatsApp Business)
EMAIL_FROM="notifications@deltacare.bd"
EMAIL_API_KEY=""
SMS_PROVIDER="sslwireless-bd"
SMS_API_KEY=""
WHATSAPP_BUSINESS_PHONE_ID=""
WHATSAPP_ACCESS_TOKEN=""

# Observability & Rate Limiting
SENTRY_DSN=""
OTEL_EXPORTER_OTLP_ENDPOINT=""
REDIS_URL=""

