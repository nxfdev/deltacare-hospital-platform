# ============================================================================
# Evercare Hospital Platform — Environment Configuration (.env.example)
# Dedicated installation per hospital. Never commit real credentials.
# ============================================================================

# Application Identity & URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_HOSPITAL_NAME="Evercare"
NEXT_PUBLIC_HOSPITAL_TAGLINE="Care at Evercare"
NODE_ENV="development"

# Database (PostgreSQL — Prisma ORM)
DATABASE_URL="postgresql://evercare_user:CHANGE_ME@localhost:5432/evercare_hospital?schema=public"

# Authentication & Session Security (Single Unified Auth Provider)
AUTH_SECRET="replace-with-at-least-32-bytes-of-cryptographic-randomness"
AUTH_URL="http://localhost:3000"
SESSION_COOKIE_NAME="evercare_session"

# S3-Compatible Object Storage (Doctor Profiles, Branch Media, Approved Documents)
S3_ENDPOINT="https://s3.ap-southeast-1.amazonaws.com"
S3_REGION="ap-southeast-1"
S3_BUCKET="evercare-hospital-media"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# AI Provider Adapter (Grounded Evercare Assistant & Staff Update Assistant)
AI_PROVIDER="grounded-local" # Options: grounded-local | openai | gemini
AI_API_KEY=""
AI_MODEL="gemini-2.5-flash"

# Patient Communication Adapters (Email, SMS, WhatsApp Business)
EMAIL_FROM="notifications@evercare.bd"
EMAIL_API_KEY=""
SMS_PROVIDER="sslwireless-bd"
SMS_API_KEY=""
WHATSAPP_BUSINESS_PHONE_ID=""
WHATSAPP_ACCESS_TOKEN=""

# Observability & Rate Limiting
SENTRY_DSN=""
OTEL_EXPORTER_OTLP_ENDPOINT=""
REDIS_URL=""


# Grok (xAI) patient assistant — falls back to the local grounded assistant if unset/invalid
AI_PROVIDER="grok"
XAI_API_KEY=""
XAI_MODEL="grok-4.7"
XAI_API_URL="https://api.x.ai/v1/responses"

# TextBee SMS gateway (https://textbee.dev). Device id is auto-discovered when blank.
SMS_PROVIDER="textbee"
TEXTBEE_API_KEY=""
TEXTBEE_DEVICE_ID=""

# Facebook page auto-post (needs a valid, non-expired Page access token)
FB_PAGE_ID=""
FB_PAGE_ACCESS_TOKEN=""
FB_API_VERSION="v21.0"
FB_AUTO_PUBLISH_ENABLED="true"
